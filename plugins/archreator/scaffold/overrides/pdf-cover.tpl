<!--
  The PDF's cover. It carries one thing the portal's own pages carry in their
  footer and a printed copy otherwise loses: what this document is, and that it
  is not the model.
-->
<div class="print-page-cover">
  <h1>{{ config.site_name }}</h1>
  <p style="font-size:1.1em">{{ config.site_description }}</p>
  <hr>
  <p><strong>This is a disposable snapshot.</strong> It was printed from the
  repository on a date and it is already behind. <strong>The repository is the
  model</strong>; this is a rendering of it, kept by nobody and regenerated on
  demand. Do not quote it as a record, and do not commit it — every page names
  the file it came from, and that file is the thing to read.</p>
</div>
